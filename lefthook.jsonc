// NAME: Lefthook Configuration
// PATH: /lefthook.jsonc

{
	"$schema": "https://json.schemastore.org/lefthook.json",
	"pre-commit": {
		"commands": {
			"lint": {
				"run": "pnpm lint {staged_files}",
				"glob": "**/*.{js,jsx,ts,tsx,cjs,mjs,cts,mts,css,html,vue,svelte,astro,json,jsonc}",
				"exclude": ".agents/**,src/routeTree.gen.ts",
				"stage_fixed": true
			}
		}
	}
}
